# ============================================================================
# P8 Collects OS — variables de entorno
#
# Copia este archivo a `.env.local` y llena los valores. `.env.local` está en
# .gitignore: ningún secreto real entra al repositorio.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Panel del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Solo servidor. Salta RLS por completo: nunca se expone al navegador ni se
# antepone NEXT_PUBLIC_ a su nombre.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Referencia del proyecto (la parte del subdominio). La usa `npm run db:link`.
SUPABASE_PROJECT_REF="xxxxxxxxxxxxxxxxxxxx"

# --- Aplicación -------------------------------------------------------------
# URL pública del sitio. Debe coincidir con la Site URL configurada en Supabase
# Auth, porque los enlaces de acceso por correo vuelven a esta dirección.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google entra por Supabase Auth. Ponlo en "true" solo cuando el proveedor esté
# configurado allá; si no, el botón no aparece.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# --- Visión (opcional) ------------------------------------------------------
# Solo servidor. Con ella, el importador puede sacar los campos de una carta a
# partir de una FOTO del slab o de una lista. Sin ella, esa entrada del wizard
# se muestra apagada y explica qué falta: el resto del importador funciona
# igual.
ANTHROPIC_API_KEY=""

# --- Monitoreo (opcional) ---------------------------------------------------
# Sin DSN, Sentry queda apagado y el build no lo envuelve.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ============================================================================
# Llegan en fases posteriores. Se dejan documentadas para que no aparezcan
# de sorpresa:
#
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET      → Fase 4 (tienda)
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY             → Fase 4
#   RESEND_API_KEY                                 → Fase 4 (correos)
# ============================================================================
